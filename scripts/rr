#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
if command -v realpath >/dev/null 2>&1; then
  SCRIPT_PATH="$(realpath "$SCRIPT_PATH")"
elif command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink "$SCRIPT_PATH" 2>/dev/null || true)"
  if [[ -n "$RESOLVED" ]]; then
    [[ "$RESOLVED" = /* ]] && SCRIPT_PATH="$RESOLVED" || SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && cd "$(dirname "$RESOLVED")" && pwd)/$(basename "$RESOLVED")"
  fi
fi
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT/scripts/lib/common.sh"
source "$ROOT/scripts/lib/config.sh"
source "$ROOT/scripts/lib/validate.sh"
source "$ROOT/scripts/lib/selector.sh"
source "$ROOT/scripts/lib/policy.sh"
source "$ROOT/scripts/lib/target.sh"
source "$ROOT/scripts/lib/report.sh"
source "$ROOT/scripts/lib/audit.sh"
source "$ROOT/scripts/lib/lock.sh"
source "$ROOT/scripts/actions/health.sh"
source "$ROOT/scripts/actions/deploy.sh"
source "$ROOT/scripts/actions/logs.sh"
source "$ROOT/scripts/actions/status.sh"
source "$ROOT/scripts/actions/metrics.sh"
source "$ROOT/scripts/actions/sync.sh"
source "$ROOT/scripts/actions/restart.sh"
source "$ROOT/scripts/actions/rollback.sh"
source "$ROOT/scripts/actions/diagnose.sh"
source "$ROOT/scripts/actions/exec.sh"
source "$ROOT/scripts/actions/compare.sh"
source "$ROOT/scripts/actions/port-check.sh"
source "$ROOT/scripts/actions/smoke-test.sh"
source "$ROOT/scripts/actions/build.sh"
source "$ROOT/scripts/actions/package.sh"
source "$ROOT/scripts/actions/backup.sh"
source "$ROOT/scripts/actions/upload.sh"
source "$ROOT/scripts/actions/switch_release.sh"
source "$ROOT/scripts/actions/cleanup.sh"
source "$ROOT/scripts/actions/db-check.sh"
source "$ROOT/scripts/actions/logs_collect.sh"
source "$ROOT/scripts/actions/report.sh"

DRY_RUN=false
YES=false
VERBOSE=false
JSON=false
PARALLEL=false
SERIAL=false
LIMIT=0
TIMEOUT=10
TAIL=200
FOLLOW=false
NO_COLOR=false
REPORT=false

usage() {
  cat <<U
rr help
rr version
rr init
rr doctor
rr doctor cli
rr validate
rr config explain
rr host plan-add --scope project|user --env <env> --name <host> --ssh-alias <alias> --host <address> --user <user>
rr host add --scope project|user --env <env> --name <host> --ssh-alias <alias> --host <address> --user <user>
rr host onboard-plan --env <env> --address <address> --user <user> --role <role> --scope project|user
rr host onboard-apply --yes --from-plan <plan-file>
rr host list
rr host validate <host>
rr host remove <host>
rr env attach <env> <host>
rr ssh doctor <host>
rr ssh bootstrap <host>
rr plan <action> <target>
rr list
rr list hosts|envs|tasks|labels
rr health <target>
rr deploy <target>
rr logs <target>
rr status <target>
rr restart <target>
rr metrics <target>
rr sync <target>
rr cleanup <target>
rr backup <target>
rr port-check <target>
rr port find <target> --from 18080 --to 18100
rr demo docker plan <target>
rr demo docker deploy <target> --yes
rr demo docker status <target>
rr demo docker health <target>
rr demo docker cleanup <target> --yes
rr db-check <target>
rr smoke-test <target>
rr rollback <target>
rr diagnose <target>
rr exec <target> "<command>"
rr run <task> <target>
rr compare <target-a> <target-b>
rr lock list
rr lock clear <target>
U
}

ensure_project_config() {
  mkdir -p .remote-runtime
  [[ -f .remote-runtime/inventory.yaml ]] || cp "$ROOT/config/inventory.yaml" .remote-runtime/inventory.yaml
  [[ -f .remote-runtime/environments.yaml ]] || cp "$ROOT/config/environments.yaml" .remote-runtime/environments.yaml
  [[ -f .remote-runtime/tasks.yaml ]] || cp "$ROOT/config/tasks.yaml" .remote-runtime/tasks.yaml
  [[ -f .remote-runtime/runtime.yaml ]] || cp "$ROOT/config/runtime.yaml" .remote-runtime/runtime.yaml
}

ensure_user_config() {
  mkdir -p "$RR_USER_CFG_DIR"
  [[ -f "$RR_USER_CFG_DIR/inventory.yaml" ]] || cp "$ROOT/config/inventory.yaml" "$RR_USER_CFG_DIR/inventory.yaml"
  [[ -f "$RR_USER_CFG_DIR/environments.yaml" ]] || cp "$ROOT/config/environments.yaml" "$RR_USER_CFG_DIR/environments.yaml"
  [[ -f "$RR_USER_CFG_DIR/tasks.yaml" ]] || cp "$ROOT/config/tasks.yaml" "$RR_USER_CFG_DIR/tasks.yaml"
  [[ -f "$RR_USER_CFG_DIR/runtime.yaml" ]] || cp "$ROOT/config/runtime.yaml" "$RR_USER_CFG_DIR/runtime.yaml"
}

scope_paths() {
  local scope="$1"
  case "$scope" in
    project) printf '%s\n%s\n' "$RR_PROJECT_DIR/inventory.yaml" "$RR_PROJECT_DIR/environments.yaml" ;;
    user) printf '%s\n%s\n' "$RR_USER_CFG_DIR/inventory.yaml" "$RR_USER_CFG_DIR/environments.yaml" ;;
    *) die "scope must be project or user" ;;
  esac
}

ensure_scope_config() {
  case "$1" in
    project) ensure_project_config ;;
    user) ensure_user_config ;;
    *) die "scope must be project or user" ;;
  esac
}

ensure_ssh_include() {
  local ssh_dir="${RR_SSH_CONFIG_DIR:-$HOME/.ssh/config.d}"
  local ssh_config="${RR_SSH_CONFIG_FILE:-$HOME/.ssh/config}"
  mkdir -p "$ssh_dir"
  touch "$ssh_config"
  if ! grep -Fq 'Include ~/.ssh/config.d/*.conf' "$ssh_config"; then
    printf '\nInclude ~/.ssh/config.d/*.conf\n' >> "$ssh_config"
  fi
}

parse_host_add_args() {
  HOST_SCOPE="project"
  HOST_ENV=""
  HOST_NAME=""
  HOST_ALIAS=""
  HOST_ADDRESS=""
  HOST_USER=""
  HOST_TYPE="lan"
  HOST_PROVIDER="home"
  HOST_LOCATION="local"
  HOST_ROLE="test"
  HOST_INDEX="01"
  HOST_SERVICE_NAME="myapp"
  HOST_DEPLOY_METHOD="jar-systemd"
  HOST_WORKDIR="/opt/apps/myapp"
  HOST_HEALTH_URL="http://127.0.0.1:8080/actuator/health"
  HOST_LABELS="test,onboarded"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env) HOST_ENV="$2"; shift ;;
      --scope) HOST_SCOPE="$2"; shift ;;
      --name) HOST_NAME="$2"; shift ;;
      --ssh-alias) HOST_ALIAS="$2"; shift ;;
      --host) HOST_ADDRESS="$2"; shift ;;
      --user) HOST_USER="$2"; shift ;;
      --type) HOST_TYPE="$2"; shift ;;
      --provider) HOST_PROVIDER="$2"; shift ;;
      --location) HOST_LOCATION="$2"; shift ;;
      --role) HOST_ROLE="$2"; shift ;;
      --index) HOST_INDEX="$2"; shift ;;
      --service-name) HOST_SERVICE_NAME="$2"; shift ;;
      --deploy-method) HOST_DEPLOY_METHOD="$2"; shift ;;
      --workdir) HOST_WORKDIR="$2"; shift ;;
      --health-url) HOST_HEALTH_URL="$2"; shift ;;
      --labels) HOST_LABELS="$2"; shift ;;
      *) die "unknown host add option: $1" ;;
    esac
    shift
  done

  [[ -z "$HOST_ENV" ]] && die "missing --env"
  [[ -z "$HOST_NAME" ]] && die "missing --name"
  [[ -z "$HOST_ALIAS" ]] && die "missing --ssh-alias"
  [[ -z "$HOST_ADDRESS" ]] && die "missing --host"
  [[ -z "$HOST_USER" ]] && die "missing --user"
  [[ "$HOST_SCOPE" != "project" && "$HOST_SCOPE" != "user" ]] && die "scope must be project or user"
  if [[ "$HOST_ALIAS" =~ [[:space:]] ]]; then
    die "ssh alias must not contain spaces"
  fi
}

print_host_plan() {
  local inv envs
  inv="$(scope_paths "$HOST_SCOPE" | sed -n '1p')"
  envs="$(scope_paths "$HOST_SCOPE" | sed -n '2p')"
  echo "host add plan"
  echo "  scope: $HOST_SCOPE"
  echo "  env: $HOST_ENV"
  echo "  name: $HOST_NAME"
  echo "  ssh_alias: $HOST_ALIAS"
  echo "  address: $HOST_ADDRESS"
  echo "  user: $HOST_USER"
  echo "  role: $HOST_ROLE"
  echo "  provider: $HOST_PROVIDER"
  echo "  location: $HOST_LOCATION"
  echo "  inventory: $inv"
  echo "  environments: $envs"
  echo "  ssh_config: ~/.ssh/config.d/remote-runtime.conf"
  echo "  secrets: passwords are never stored"
}

write_host_config() {
  require_cmd yq
  local inv envs
  ensure_scope_config "$HOST_SCOPE"
  inv="$(scope_paths "$HOST_SCOPE" | sed -n '1p')"
  envs="$(scope_paths "$HOST_SCOPE" | sed -n '2p')"
  yq eval -i ".hosts.\"$HOST_NAME\" = {
    \"type\": \"$HOST_TYPE\",
    \"provider\": \"$HOST_PROVIDER\",
    \"location\": \"$HOST_LOCATION\",
    \"role\": \"$HOST_ROLE\",
    \"index\": \"$HOST_INDEX\",
    \"ssh_alias\": \"$HOST_ALIAS\",
    \"description\": \"Onboarded host\",
    \"labels\": (\"$HOST_LABELS\" | split(\",\")),
    \"vars\": {
      \"service_name\": \"$HOST_SERVICE_NAME\",
      \"deploy_method\": \"$HOST_DEPLOY_METHOD\",
      \"health_url\": \"$HOST_HEALTH_URL\",
      \"workdir\": \"$HOST_WORKDIR\"
    }
  }" "$inv"
  attach_env_host "$HOST_ENV" "$HOST_NAME" "$HOST_SCOPE"
}

write_ssh_config() {
  ensure_ssh_include
  local ssh_dir="${RR_SSH_CONFIG_DIR:-$HOME/.ssh/config.d}"
  local rr_ssh_config="$ssh_dir/remote-runtime.conf"
  touch "$rr_ssh_config"
  if grep -Eq "^[[:space:]]*Host[[:space:]]+${HOST_ALIAS}\$" "$rr_ssh_config"; then
    echo "ssh alias already exists: $HOST_ALIAS"
    return 0
  fi
  {
    printf '\nHost %s\n' "$HOST_ALIAS"
    printf '  HostName %s\n' "$HOST_ADDRESS"
    printf '  User %s\n' "$HOST_USER"
    printf '  Port 22\n'
  } >> "$rr_ssh_config"
}

attach_env_host() {
  local env="$1" host="$2" scope="${3:-project}" inv envs
  ensure_scope_config "$scope"
  inv="$(scope_paths "$scope" | sed -n '1p')"
  envs="$(scope_paths "$scope" | sed -n '2p')"
  if ! yq eval -e ".environments.\"$env\"" "$envs" >/dev/null 2>&1; then
    yq eval -i ".environments.\"$env\" = {\"description\":\"Auto-created environment\",\"protected\":false,\"strategy\":\"serial\",\"hosts\":[],\"vars\":{}}" "$envs"
  fi
  yq eval -i ".environments.\"$env\".hosts += [\"$host\"] | .environments.\"$env\".hosts |= unique" "$envs"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

parse_onboard_args() {
  HOST_ENV=""
  HOST_ADDRESS=""
  HOST_USER=""
  HOST_PROVIDER="local"
  HOST_LOCATION="local"
  HOST_ROLE="app"
  HOST_SCOPE="project"
  HOST_INDEX="01"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env) HOST_ENV="$2"; shift ;;
      --address) HOST_ADDRESS="$2"; shift ;;
      --user) HOST_USER="$2"; shift ;;
      --provider) HOST_PROVIDER="$(slugify "$2")"; shift ;;
      --location) HOST_LOCATION="$(slugify "$2")"; shift ;;
      --role) HOST_ROLE="$(slugify "$2")"; shift ;;
      --scope) HOST_SCOPE="$2"; shift ;;
      --index) HOST_INDEX="$2"; shift ;;
      *) die "unknown onboard option: $1" ;;
    esac
    shift
  done
  [[ -z "$HOST_ENV" ]] && die "missing --env"
  [[ -z "$HOST_ADDRESS" ]] && die "missing --address"
  [[ -z "$HOST_USER" ]] && die "missing --user"
  [[ "$HOST_SCOPE" != "project" && "$HOST_SCOPE" != "user" ]] && die "scope must be project or user"
  HOST_TYPE="lan"
  HOST_NAME="lan-${HOST_PROVIDER}-${HOST_LOCATION}-${HOST_ROLE}-${HOST_INDEX}"
  HOST_ALIAS="$HOST_NAME"
}

write_onboard_plan() {
  require_cmd yq
  parse_onboard_args "$@"
  mkdir -p "$RR_HOME/plans"
  local plan_file="$RR_HOME/plans/onboard-${HOST_NAME}.yaml"
  cat > "$plan_file" <<Y
scope: "$HOST_SCOPE"
env: "$HOST_ENV"
name: "$HOST_NAME"
ssh_alias: "$HOST_ALIAS"
address: "$HOST_ADDRESS"
user: "$HOST_USER"
type: "$HOST_TYPE"
provider: "$HOST_PROVIDER"
location: "$HOST_LOCATION"
role: "$HOST_ROLE"
index: "$HOST_INDEX"
Y
  echo "host onboard plan"
  echo "  scope: $HOST_SCOPE"
  echo "  env: $HOST_ENV"
  echo "  name: $HOST_NAME"
  echo "  ssh_alias: $HOST_ALIAS"
  echo "  address: $HOST_ADDRESS"
  echo "  user: $HOST_USER"
  echo "  plan_file: $plan_file"
  echo "  ssh_config: ~/.ssh/config.d/remote-runtime.conf"
  echo "  inventory stores ssh_alias only"
  echo "  address is written only to local SSH config"
  echo "  passwords are never stored"
  echo "  apply validates: rr validate; rr host validate $HOST_NAME; rr ssh doctor $HOST_NAME"
}

apply_onboard_plan() {
  require_cmd yq
  local plan_file="" confirm=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from-plan) plan_file="$2"; shift ;;
      --yes) confirm=true ;;
      *) die "unknown onboard apply option: $1" ;;
    esac
    shift
  done
  [[ "$YES" == "true" ]] && confirm=true
  [[ "$confirm" != "true" ]] && die "rr host onboard-apply requires --yes"
  [[ -z "$plan_file" ]] && die "missing --from-plan"
  [[ -f "$plan_file" ]] || die "plan file not found: $plan_file"
  HOST_SCOPE="$(yq eval '.scope' "$plan_file")"
  HOST_ENV="$(yq eval '.env' "$plan_file")"
  HOST_NAME="$(yq eval '.name' "$plan_file")"
  HOST_ALIAS="$(yq eval '.ssh_alias' "$plan_file")"
  HOST_ADDRESS="$(yq eval '.address' "$plan_file")"
  HOST_USER="$(yq eval '.user' "$plan_file")"
  HOST_TYPE="$(yq eval '.type' "$plan_file")"
  HOST_PROVIDER="$(yq eval '.provider' "$plan_file")"
  HOST_LOCATION="$(yq eval '.location' "$plan_file")"
  HOST_ROLE="$(yq eval '.role' "$plan_file")"
  HOST_INDEX="$(yq eval '.index' "$plan_file")"
  HOST_SERVICE_NAME="myapp"
  HOST_DEPLOY_METHOD="jar-systemd"
  HOST_WORKDIR="/opt/apps/myapp"
  HOST_HEALTH_URL="http://127.0.0.1:8080/actuator/health"
  HOST_LABELS="test,onboarded"
  write_host_config
  write_ssh_config
  echo "host onboarded: $HOST_NAME"
  validate_configs
  host_command validate "$HOST_NAME"
  ssh_command doctor "$HOST_NAME"
}

host_command() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    plan-add)
      parse_host_add_args "$@"
      print_host_plan
      ;;
    add)
      parse_host_add_args "$@"
      write_host_config
      write_ssh_config
      echo "host added: $HOST_NAME"
      echo "ssh alias: $HOST_ALIAS"
      ;;
    onboard-plan)
      write_onboard_plan "$@"
      ;;
    onboard-apply)
      apply_onboard_plan "$@"
      ;;
    list)
      build_compiled_configs >/dev/null
      yq eval '.hosts | keys | .[]' "$CFG_DIR/inventory.yaml"
      ;;
    validate)
      local host="${1:-}"
      [[ -z "$host" ]] && die "usage: rr host validate <host>"
      build_compiled_configs >/dev/null
      yq eval -e ".hosts.\"$host\"" "$CFG_DIR/inventory.yaml" >/dev/null || die "unknown host: $host"
      local alias
      alias="$(yq eval ".hosts.\"$host\".ssh_alias" "$CFG_DIR/inventory.yaml")"
      [[ "$alias" == "null" || -z "$alias" ]] && die "missing ssh_alias for $host"
      echo "host valid: $host"
      ;;
    remove)
      local host="${1:-}"
      [[ -z "$host" ]] && die "usage: rr host remove <host>"
      ensure_project_config
      yq eval -i "del(.hosts.\"$host\")" .remote-runtime/inventory.yaml
      yq eval -i "(.environments[]?.hosts // []) |= map(select(. != \"$host\"))" .remote-runtime/environments.yaml
      echo "host removed from project config: $host"
      ;;
    *) die "usage: rr host plan-add|add|onboard-plan|onboard-apply|list|validate|remove" ;;
  esac
}

env_command() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    attach)
      [[ $# -ne 2 ]] && die "usage: rr env attach <env> <host>"
      attach_env_host "$1" "$2"
      echo "attached $2 to env:$1"
      ;;
    *) die "usage: rr env attach <env> <host>" ;;
  esac
}

ssh_command() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    doctor)
      local host="${1:-}"
      [[ -z "$host" ]] && die "usage: rr ssh doctor <host>"
      build_compiled_configs >/dev/null
      local alias
      alias="$(yq eval ".hosts.\"$host\".ssh_alias" "$CFG_DIR/inventory.yaml")"
      [[ "$alias" == "null" || -z "$alias" ]] && die "missing ssh_alias for $host"
      ssh -G "$alias" >/dev/null 2>&1 && echo "ssh alias resolvable: $alias" || die "ssh alias not resolvable: $alias"
      ;;
    bootstrap)
      local host="${1:-}"
      [[ -z "$host" ]] && die "usage: rr ssh bootstrap <host>"
      build_compiled_configs >/dev/null
      local alias key
      alias="$(yq eval ".hosts.\"$host\".ssh_alias" "$CFG_DIR/inventory.yaml")"
      key="$HOME/.ssh/remote-runtime_${host}"
      [[ -f "$key" ]] || ssh-keygen -t ed25519 -f "$key" -N ""
      echo "public key: ${key}.pub"
      echo "run: ssh-copy-id -i ${key}.pub ${alias}"
      ;;
    *) die "usage: rr ssh doctor|bootstrap <host>" ;;
  esac
}

config_command() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    explain)
      echo "remote-runtime config explain"
      echo "  skill defaults: $ROOT/config"
      echo "  project config: $RR_PROJECT_DIR"
      echo "  user overlays: $RR_USER_CFG_DIR"
      echo "  compiled cache: $CFG_DIR"
      echo "  read order:"
      echo "    1) $ROOT/config"
      echo "    2) $RR_PROJECT_DIR"
      echo "    3) $RR_USER_CFG_DIR"
      echo "  write defaults:"
      echo "    rr host add --scope project -> $RR_PROJECT_DIR/inventory.yaml and environments.yaml"
      echo "    rr host add --scope user -> $RR_USER_CFG_DIR/inventory.yaml and environments.yaml"
      echo "    ssh connection details -> ~/.ssh/config.d/remote-runtime.conf"
      ;;
    *) die "usage: rr config explain" ;;
  esac
}

doctor_cli() {
  local rr_path="" current=""
  rr_path="$(command -v rr 2>/dev/null || true)"
  current="$SCRIPT_PATH"
  echo "rr executable: ${rr_path:-not found in PATH}"
  echo "current script: $current"
  echo "skill root: $ROOT"
  if [[ -z "$rr_path" ]]; then
    echo "PATH status: ~/.local/bin/rr is not directly executable from PATH"
    echo "fix: run ./install.sh --with-cli and add ~/.local/bin to PATH"
  else
    echo "PATH status: ok"
  fi
  for c in bash ssh rsync curl yq docker; do
    if command -v "$c" >/dev/null 2>&1; then
      echo "tool $c: $(command -v "$c")"
    else
      echo "tool $c: missing"
    fi
  done
}

parse_demo_docker_args() {
  DEMO_NAME="rr-demo-nginx"
  DEMO_PORT="auto"
  DEMO_WORKDIR="~/rr-demo"
  DEMO_IMAGE="nginx:alpine"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) DEMO_NAME="$2"; shift ;;
      --port) DEMO_PORT="$2"; shift ;;
      --workdir) DEMO_WORKDIR="$2"; shift ;;
      --image) DEMO_IMAGE="$2"; shift ;;
      *) die "unknown docker demo option: $1" ;;
    esac
    shift
  done
}

demo_docker_command_string() {
  local mode="$1" port="$2"
  case "$mode" in
    deploy)
      printf 'mkdir -p %q && cd %q && cat > docker-compose.yml <<'"'"'YAML'"'"'\nservices:\n  app:\n    image: %s\n    container_name: %s\n    ports:\n      - "127.0.0.1:%s:80"\n    restart: unless-stopped\nYAML\ndocker compose up -d' "$DEMO_WORKDIR" "$DEMO_WORKDIR" "$DEMO_IMAGE" "$DEMO_NAME" "$port"
      ;;
    status)
      printf 'cd %q && docker compose ps && docker inspect --format="{{.State.Status}}" %q' "$DEMO_WORKDIR" "$DEMO_NAME"
      ;;
    health)
      printf 'curl -fsS http://127.0.0.1:%s/' "$port"
      ;;
    cleanup)
      printf 'cd %q && docker compose down --remove-orphans && docker rm -f %q 2>/dev/null || true' "$DEMO_WORKDIR" "$DEMO_NAME"
      ;;
  esac
}

demo_docker() {
  local sub="${1:-}" target="${2:-}"
  [[ -z "$sub" || -z "$target" ]] && die "usage: rr demo docker plan|deploy|status|health|cleanup <target>"
  shift 2
  parse_demo_docker_args "$@"
  build_compiled_configs >/dev/null
  local port="$DEMO_PORT"
  [[ "$port" == "auto" ]] && port="38180"
  case "$sub" in
    plan)
      echo "docker demo plan"
      echo "  target: $target"
      echo "  name: $DEMO_NAME"
      echo "  image: $DEMO_IMAGE"
      echo "  workdir: $DEMO_WORKDIR"
      echo "  port: $DEMO_PORT"
      echo "  deploy: rr demo docker deploy $target --port $DEMO_PORT --yes"
      echo "  status: rr demo docker status $target --port $port"
      echo "  health: rr demo docker health $target --port $port"
      echo "  cleanup: rr demo docker cleanup $target --yes"
      ;;
    deploy|cleanup)
      [[ "$YES" != "true" ]] && die "rr demo docker $sub requires --yes"
      local hosts h cmd
      if [[ "$sub" == "deploy" && "$DEMO_PORT" == "auto" && "$DRY_RUN" != "true" ]]; then
        local first_host find_cmd
        first_host="$(resolve_or_fail "$target" | sed -n '1p')"
        find_cmd='for p in $(seq 38180 38200); do (ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null) | grep -q ":$p " || { echo $p; exit 0; }; done; exit 1'
        port="$(ssh_exec "$first_host" "$find_cmd" false | tail -n 1 | mask_output)"
        [[ -z "$port" ]] && die "no free demo port found in range 38180-38200"
      fi
      hosts="$(resolve_or_fail "$target")"
      cmd="$(demo_docker_command_string "$sub" "$port")"
      while IFS= read -r h; do
        [[ -z "$h" ]] && continue
        ssh_exec "$h" "$cmd" "$DRY_RUN" | mask_output
      done <<< "$hosts"
      echo "docker demo report"
      echo "  container_name: $DEMO_NAME"
      echo "  compose_project_dir: $DEMO_WORKDIR"
      echo "  selected_port: $port"
      echo "  status_command: rr demo docker status $target --port $port"
      echo "  health_command: rr demo docker health $target --port $port"
      echo "  cleanup_command: rr demo docker cleanup $target --yes"
      ;;
    status|health)
      local hosts h cmd
      hosts="$(resolve_or_fail "$target")"
      cmd="$(demo_docker_command_string "$sub" "$port")"
      while IFS= read -r h; do
        [[ -z "$h" ]] && continue
        ssh_exec "$h" "$cmd" "$DRY_RUN" | mask_output
      done <<< "$hosts"
      ;;
    *) die "usage: rr demo docker plan|deploy|status|health|cleanup <target>" ;;
  esac
}

port_command() {
  local sub="${1:-}" target="${2:-}"
  [[ "$sub" != "find" || -z "$target" ]] && die "usage: rr port find <target> --from 18080 --to 18100"
  shift 2
  local from=18080 to=18100
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="$2"; shift ;;
      --to) to="$2"; shift ;;
      *) die "unknown port find option: $1" ;;
    esac
    shift
  done
  build_compiled_configs >/dev/null
  local hosts h cmd first=true
  hosts="$(resolve_or_fail "$target")"
  cmd="for p in \$(seq $from $to); do (ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null) | grep -q \":\$p \" || { echo \$p; exit 0; }; done; exit 1"
  while IFS= read -r h; do
    [[ -z "$h" ]] && continue
    if [[ "$DRY_RUN" == "true" ]]; then
      ssh_exec "$h" "$cmd" true | mask_output
      $first && echo "suggested_port: $from"
    else
      local found
      found="$(ssh_exec "$h" "$cmd" false | tail -n 1 | mask_output)"
      [[ -z "$found" ]] && die "no free port found in range $from-$to"
      echo "suggested_port: $found"
    fi
    first=false
  done <<< "$hosts"
}

parse_flags() {
  local rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=true ;;
      --yes) YES=true ;;
      --verbose) VERBOSE=true ;;
      --json) JSON=true ;;
      --parallel) PARALLEL=true ;;
      --serial) SERIAL=true ;;
      --limit) LIMIT="$2"; shift ;;
      --timeout) TIMEOUT="$2"; shift ;;
      --tail) TAIL="$2"; shift ;;
      --follow) FOLLOW=true ;;
      --no-color) NO_COLOR=true ;;
      --report) REPORT=true ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  set -- "${rest[@]}"
  CMD_ARGS=("$@")
}

hosts_json_for_target() {
  local target="$1"
  local hosts h out=""
  hosts="$(resolve_or_fail "$target")" || return $?
  while IFS= read -r h; do
    [[ -z "$h" ]] && continue
    out+="\"$(json_escape "$h")\","
  done <<< "$hosts"
  printf '%s' "${out%,}"
}

current_millis() {
  printf '%s000' "$(date +%s)"
}

run_managed_action() {
  local action="$1" target="$2" fn="$3"
  shift 3
  local start end duration hosts_json rc success
  start="$(current_millis)"

  enforce_action_policy "$action" "$target" "$DRY_RUN" "$YES"

  set +e
  hosts_json="$(hosts_json_for_target "$target")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    end="$(current_millis)"
    duration=$((end - start))
    write_audit "$action" "$target" "" "$DRY_RUN" false "$duration"
    return "$rc"
  fi

  set +e
  "$fn" "$@"
  rc=$?
  set -e

  end="$(current_millis)"
  duration=$((end - start))
  [[ "$rc" -eq 0 ]] && success=true || success=false
  write_audit "$action" "$target" "$hosts_json" "$DRY_RUN" "$success" "$duration"
  if [[ "$REPORT" == "true" ]]; then
    write_report "$action" "$target" "success: $success
duration_ms: $duration
hosts: [$hosts_json]" >/dev/null
  fi
  return "$rc"
}

doctor() {
  local ok=true
  for c in yq ssh scp rsync curl bash; do
    command -v "$c" >/dev/null 2>&1 || { echo "missing: $c"; ok=false; }
  done
  build_compiled_configs >/dev/null || ok=false
  yq eval '.hosts | keys | length' "$CFG_DIR/inventory.yaml" >/dev/null 2>&1 || ok=false
  yq eval '.environments | keys | length' "$CFG_DIR/environments.yaml" >/dev/null 2>&1 || ok=false
  yq eval '.policies | keys | length' "$CFG_DIR/policies.yaml" >/dev/null 2>&1 || ok=false
  while IFS= read -r h; do
    [[ -z "$h" ]] && continue
    local alias workdir health
    alias="$(yq eval ".hosts.\"$h\".ssh_alias" "$CFG_DIR/inventory.yaml")"
    workdir="$(yq eval ".hosts.\"$h\".vars.workdir" "$CFG_DIR/inventory.yaml")"
    health="$(yq eval ".hosts.\"$h\".vars.health_url" "$CFG_DIR/inventory.yaml")"
    [[ "$alias" == "null" || -z "$alias" ]] && { echo "missing ssh_alias for $h"; ok=false; }
    if [[ "$alias" != "null" && -n "$alias" ]] && ! ssh -G "$alias" >/dev/null 2>&1; then
      echo "ssh_alias not resolvable for $h: $alias"
      ok=false
    fi
    [[ "$workdir" == "null" || -z "$workdir" ]] && { echo "missing workdir for $h"; ok=false; }
    [[ "$health" == "null" || -z "$health" ]] && { echo "missing health_url for $h"; ok=false; }
  done < <(yq eval '.hosts | keys | .[]' "$CFG_DIR/inventory.yaml")
  $ok && echo "doctor ok" || die "doctor failed"
}

do_init() {
  mkdir -p .remote-runtime
  local svc="${SERVICE_NAME:-myapp}" dep="${DEPLOY_METHOD:-jar-systemd}" cloud="${CLOUD_ALIAS:-jdcloud}" lan="${LAN_ALIAS:-intranet}" health="${HEALTH_URL:-http://127.0.0.1:8080/actuator/health}" wd="${WORKDIR:-/opt/apps/myapp}" artifact_dir="${ARTIFACT_DIR:-target}" artifact_pattern="${ARTIFACT_PATTERN:-*.jar}" is_java="${IS_JAVA:-true}"
  cat > .remote-runtime/inventory.yaml <<Y
hosts:
  cloud-jd-bj-app-01:
    type: cloud
    provider: jd
    location: bj
    role: app
    index: "01"
    ssh_alias: $cloud
    labels: [java, test]
    vars:
      service_name: $svc
      deploy_method: $dep
      health_url: $health
      workdir: $wd
      artifact_dir: $artifact_dir
      artifact_pattern: "$artifact_pattern"
      keep_releases: 5
      release_root: $wd/releases
      shared_dir: $wd/shared
      logs_dir: $wd/logs
      is_java: $is_java
  lan-office-local-app-01:
    type: lan
    provider: office
    location: local
    role: app
    index: "01"
    ssh_alias: $lan
    labels: [java, test]
    vars:
      service_name: $svc
      deploy_method: $dep
      health_url: $health
      workdir: $wd
      artifact_dir: $artifact_dir
      artifact_pattern: "$artifact_pattern"
      keep_releases: 5
      release_root: $wd/releases
      shared_dir: $wd/shared
      logs_dir: $wd/logs
      is_java: $is_java
Y
  cp "$ROOT/config/environments.yaml" .remote-runtime/environments.yaml
  cp "$ROOT/config/tasks.yaml" .remote-runtime/tasks.yaml
  cp "$ROOT/config/runtime.yaml" .remote-runtime/runtime.yaml
  echo "initialized .remote-runtime"
}

run_task() {
  local task="$1" target="$2"
  build_compiled_configs >/dev/null
  local risk
  risk="$(yq eval ".tasks.\"$task\".risk" "$CFG_DIR/tasks.yaml" 2>/dev/null || true)"
  if [[ "$risk" == "high" || "$risk" == "medium" ]]; then
    enforce_action_policy "$task" "$target" "$DRY_RUN" "$YES"
  fi
  local step
  while IFS= read -r step; do
    [[ -z "$step" ]] && continue
    case "$step" in
      health) action_health "$target" "$DRY_RUN" "$JSON" "$TIMEOUT" ;;
      status) action_status "$target" "$DRY_RUN" ;;
      metrics) action_metrics "$target" "$DRY_RUN" ;;
      logs) action_logs "$target" "$DRY_RUN" "$TAIL" "$FOLLOW" ;;
      restart) action_restart "$target" "$DRY_RUN" ;;
      rollback) action_rollback "$target" "$DRY_RUN" ;;
      report) [[ "$REPORT" == "true" ]] && write_report "$task" "$target" "task done" >/dev/null || true ;;
      smoke-test) action_smoke_test "$target" "$DRY_RUN" ;;
      port-check) action_port_check "$target" "$DRY_RUN" ;;
      build) action_build "$target" "$DRY_RUN" ;;
      package) action_package "$target" "$DRY_RUN" ;;
      backup) action_backup "$target" "$DRY_RUN" ;;
      cleanup) action_cleanup "$target" "$DRY_RUN" ;;
      db-check) action_db_check "$target" "$DRY_RUN" ;;
      upload) action_upload "$target" "$DRY_RUN" ;;
      switch_release) action_switch_release "$target" "$DRY_RUN" ;;
      *) echo "skip unknown step: $step" ;;
    esac
  done < <(yq eval ".tasks.\"$task\".steps[]" "$CFG_DIR/tasks.yaml" 2>/dev/null || true)
}

parse_flags "$@"
set -- "${CMD_ARGS[@]}"

cmd="${1:-help}"
case "$cmd" in
  help) usage ;;
  version) cat "$ROOT/VERSION" ;;
  doctor)
    if [[ "${2:-}" == "cli" ]]; then
      doctor_cli
    else
      doctor
    fi
    ;;
  config)
    shift
    config_command "$@"
    ;;
  validate) validate_configs ;;
  init)
    shift
    if [[ "${1:-}" == "--non-interactive" ]]; then
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --service-name) SERVICE_NAME="$2"; shift ;;
          --deploy-method) DEPLOY_METHOD="$2"; shift ;;
          --cloud-alias) CLOUD_ALIAS="$2"; shift ;;
          --lan-alias) LAN_ALIAS="$2"; shift ;;
          --health-url) HEALTH_URL="$2"; shift ;;
          --workdir) WORKDIR="$2"; shift ;;
          --artifact-dir) ARTIFACT_DIR="$2"; shift ;;
          --artifact-pattern) ARTIFACT_PATTERN="$2"; shift ;;
          --java) IS_JAVA=true ;;
          --no-java) IS_JAVA=false ;;
        esac
        shift
      done
      do_init
    else
      read -r -p "service_name [myapp]: " SERVICE_NAME; SERVICE_NAME="${SERVICE_NAME:-myapp}"
      read -r -p "deploy_method [jar-systemd]: " DEPLOY_METHOD; DEPLOY_METHOD="${DEPLOY_METHOD:-jar-systemd}"
      read -r -p "is_java [true]: " IS_JAVA; IS_JAVA="${IS_JAVA:-true}"
      read -r -p "artifact_dir [target]: " ARTIFACT_DIR; ARTIFACT_DIR="${ARTIFACT_DIR:-target}"
      read -r -p "artifact_pattern [*.jar]: " ARTIFACT_PATTERN; ARTIFACT_PATTERN="${ARTIFACT_PATTERN:-*.jar}"
      read -r -p "cloud_alias [jdcloud]: " CLOUD_ALIAS; CLOUD_ALIAS="${CLOUD_ALIAS:-jdcloud}"
      read -r -p "lan_alias [intranet]: " LAN_ALIAS; LAN_ALIAS="${LAN_ALIAS:-intranet}"
      read -r -p "health_url [http://127.0.0.1:8080/actuator/health]: " HEALTH_URL; HEALTH_URL="${HEALTH_URL:-http://127.0.0.1:8080/actuator/health}"
      read -r -p "workdir [/opt/apps/myapp]: " WORKDIR; WORKDIR="${WORKDIR:-/opt/apps/myapp}"
      do_init
    fi
    ;;
  host)
    shift
    host_command "$@"
    ;;
  env)
    shift
    env_command "$@"
    ;;
  ssh)
    shift
    ssh_command "$@"
    ;;
  demo)
    shift
    [[ "${1:-}" == "docker" ]] || die "usage: rr demo docker plan|deploy|status|health|cleanup <target>"
    shift
    demo_docker "$@"
    ;;
  port)
    shift
    port_command "$@"
    ;;
  list)
    build_compiled_configs >/dev/null
    sub="${2:-hosts}"
    case "$sub" in
      hosts) yq eval '.hosts | keys | .[]' "$CFG_DIR/inventory.yaml" ;;
      envs) yq eval '.environments | keys | .[]' "$CFG_DIR/environments.yaml" ;;
      tasks) yq eval '.tasks | keys | .[]' "$CFG_DIR/tasks.yaml" ;;
      labels) yq eval '.hosts[].labels[]' "$CFG_DIR/inventory.yaml" | sort -u ;;
      *) die "unknown list subcommand" ;;
    esac
    ;;
  plan)
    action="${2:-}"; target="${3:-}"
    [[ -z "$action" || -z "$target" ]] && die "usage: rr plan <action> <target>"
    echo "plan action=$action target=$target dry_run=$DRY_RUN"
    echo "1) resolve target"
    echo "2) check policy"
    echo "3) execute action"
    ;;
  health) run_managed_action health "${2:-}" action_health "${2:-}" "$DRY_RUN" "$JSON" "$TIMEOUT" ;;
  deploy) run_managed_action deploy "${2:-}" action_deploy "${2:-}" "$DRY_RUN" ;;
  logs) run_managed_action logs "${2:-}" action_logs "${2:-}" "$DRY_RUN" "$TAIL" "$FOLLOW" ;;
  status) run_managed_action status "${2:-}" action_status "${2:-}" "$DRY_RUN" ;;
  restart) run_managed_action restart "${2:-}" action_restart "${2:-}" "$DRY_RUN" ;;
  metrics) run_managed_action metrics "${2:-}" action_metrics "${2:-}" "$DRY_RUN" ;;
  sync) run_managed_action sync "${2:-}" action_sync "${2:-}" "$DRY_RUN" ;;
  cleanup) run_managed_action cleanup "${2:-}" action_cleanup "${2:-}" "$DRY_RUN" ;;
  backup) run_managed_action backup "${2:-}" action_backup "${2:-}" "$DRY_RUN" ;;
  port-check) run_managed_action port-check "${2:-}" action_port_check "${2:-}" "$DRY_RUN" ;;
  db-check) run_managed_action db-check "${2:-}" action_db_check "${2:-}" "$DRY_RUN" ;;
  smoke-test) run_managed_action smoke-test "${2:-}" action_smoke_test "${2:-}" "$DRY_RUN" ;;
  rollback) run_managed_action rollback "${2:-}" action_rollback "${2:-}" "$DRY_RUN" ;;
  diagnose) run_managed_action diagnose "${2:-}" action_diagnose "${2:-}" "$DRY_RUN" ;;
  exec) run_managed_action exec "${2:-}" action_exec "${2:-}" "$DRY_RUN" "${3:-}" "$JSON" ;;
  run) run_managed_action run "${3:-}" run_task "${2:-}" "${3:-}" ;;
  compare)
    start="$(current_millis)"
    set +e
    action_compare "${2:-}" "${3:-}" "$DRY_RUN"
    rc=$?
    set -e
    end="$(current_millis)"
    [[ "$rc" -eq 0 ]] && success=true || success=false
    write_audit "compare" "${2:-},${3:-}" "\"$(json_escape "${2:-}")\",\"$(json_escape "${3:-}")\"" "$DRY_RUN" "$success" "$((end - start))"
    [[ "$REPORT" == "true" ]] && write_report "compare" "${2:-}_${3:-}" "success: $success" >/dev/null
    exit "$rc"
    ;;
  lock)
    case "${2:-}" in
      list) lock_list ;;
      clear) lock_clear "${3:-}" ;;
      *) die "usage: rr lock list|clear <target>" ;;
    esac
    ;;
  *) usage; exit 1 ;;
esac
